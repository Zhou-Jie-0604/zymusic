<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>ZYMusic</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <servlet>
        <servlet-name>default</servlet-name>
        <servlet-class>org.eclipse.jetty.servlet.DefaultServlet</servlet-class>
        <load-on-startup>0</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>default</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>login</servlet-name>
        <servlet-class>com.zjlymusic.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>register</servlet-name>
        <servlet-class>com.zjlymusic.servlet.RegisterServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>logout</servlet-name>
        <servlet-class>com.zjlymusic.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>uploadMusic</servlet-name>
        <servlet-class>com.zjlymusic.servlet.UploadMusicServlet</servlet-class>
        <multipart-config>
            <max-file-size>104857600</max-file-size>
            <max-request-size>125829120</max-request-size>
            <file-size-threshold>1048576</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet>
        <servlet-name>community</servlet-name>
        <servlet-class>com.zjlymusic.servlet.CommunityServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>post</servlet-name>
        <servlet-class>com.zjlymusic.servlet.PostServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>comment</servlet-name>
        <servlet-class>com.zjlymusic.servlet.CommentServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>playMusic</servlet-name>
        <servlet-class>com.zjlymusic.servlet.PlayMusicServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>profile</servlet-name>
        <servlet-class>com.zjlymusic.servlet.ProfileServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>updateProfile</servlet-name>
        <servlet-class>com.zjlymusic.servlet.UpdateProfileServlet</servlet-class>
        <multipart-config>
            <max-file-size>5242880</max-file-size>
            <max-request-size>20971520</max-request-size>
            <file-size-threshold>1048576</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet>
        <servlet-name>files</servlet-name>
        <servlet-class>com.zjlymusic.servlet.FileServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>playlist</servlet-name>
        <servlet-class>com.zjlymusic.servlet.PlaylistServlet</servlet-class>
        <multipart-config>
            <max-file-size>5242880</max-file-size>
            <max-request-size>20971520</max-request-size>
            <file-size-threshold>1048576</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet>
        <servlet-name>like</servlet-name>
        <servlet-class>com.zjlymusic.servlet.LikeServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>deleteMusic</servlet-name>
        <servlet-class>com.zjlymusic.servlet.DeleteMusicServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>messages</servlet-name>
        <servlet-class>com.zjlymusic.servlet.MessageServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>notifications</servlet-name>
        <servlet-class>com.zjlymusic.servlet.NotificationServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>notFound</servlet-name>
        <servlet-class>com.zjlymusic.servlet.NotFoundServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>login</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>register</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>logout</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>uploadMusic</servlet-name>
        <url-pattern>/uploadMusic</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>community</servlet-name>
        <url-pattern>/community</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>post</servlet-name>
        <url-pattern>/post</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>comment</servlet-name>
        <url-pattern>/comment</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>playMusic</servlet-name>
        <url-pattern>/playMusic</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>profile</servlet-name>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>updateProfile</servlet-name>
        <url-pattern>/updateProfile</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>files</servlet-name>
        <url-pattern>/files/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>playlist</servlet-name>
        <url-pattern>/playlist</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>like</servlet-name>
        <url-pattern>/like</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>deleteMusic</servlet-name>
        <url-pattern>/deleteMusic</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>messages</servlet-name>
        <url-pattern>/messages</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>notifications</servlet-name>
        <url-pattern>/notifications</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>notFound</servlet-name>
        <url-pattern>/not-found-test</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <error-page>
        <error-code>404</error-code>
        <location>/index.jsp</location>
    </error-page>

</web-app>
